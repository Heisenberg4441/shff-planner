      {
        "selector": "JSXOpeningElement[name.name='TopbarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<TopbarItem> doesn't accept that prop. Declared props: label, href."
