{
  "name": "shff-planner",
  "version": "1.0.0",
  "private": true,
  "description": "SHFF Planner — поминутный планировщик суток. Self-hosted, локальная база, без трекинга.",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace server && npm run build --workspace web",
    "start": "node server/dist/server/src/index.js",
    "typecheck": "tsc -p server/tsconfig.test.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "fonts": "node scripts/fetch-fonts.mjs",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f planner"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
