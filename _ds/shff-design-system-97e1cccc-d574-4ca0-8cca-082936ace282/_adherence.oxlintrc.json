      {
        "selector": "JSXOpeningElement[name.name='TerminalWindow'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|minHeight|key|ref|className|style|children)$/]",
        "message": "<TerminalWindow> doesn't accept that prop. Declared props: title, children, minHeight."
