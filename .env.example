# ============================================================
#  SHFF Planner — конфигурация
#  Скопируй в .env и правь. Всё необязательно: сервис поднимается
#  с пустым файлом и вообще без него.
# ============================================================

# ---------- то, что читает docker compose ----------

# Порт на хосте. Внутри контейнера сервис всегда слушает 8787.
SHFF_HOST_PORT=8787

# Аварийный ключ. Обычно НЕ НУЖЕН: аккаунт администратора заводится при первом
# заходе в панель и хранится в базе. Если переменная задана, она перебивает базу —
# вход только по ней, и панель замок не меняет. Пригодится, если забыл пароль
# или разворачиваешь сервис заранее настроенным.
SHFF_AUTH_PASSWORD=
SHFF_AUTH_LOGIN=admin

# Секрет для подписи cookie сессии. Пусто — сгенерируется сам
# и сохранится в /data/session.key, так что вход переживёт перезапуск.
SHFF_SESSION_SECRET=

# Что положить в пустую базу при первом запуске:
#   none — ничего, чистый планировщик (по умолчанию)
#   demo — примерная неделя вокруг сегодня, чтобы посмотреть все режимы
SHFF_SEED=none

# Уровень логов: fatal | error | warn | info | debug | trace | silent
SHFF_LOG_LEVEL=info

# Доверять заголовкам X-Forwarded-*. Включи, если стоишь за reverse proxy:
# от этого зависит, чей IP попадёт в счётчик попыток входа.
SHFF_TRUST_PROXY=false

# Часовой пояс контейнера. Даты блоков хранятся как YYYY-MM-DD без зоны,
# поэтому это влияет только на логи и метки created_at.
TZ=Europe/Moscow

# ---------- только для запуска без Docker (npm start) ----------
# В образе эти значения уже выставлены и менять их не нужно.

# SHFF_PORT=8787
# SHFF_HOST=0.0.0.0
# SHFF_DATA_DIR=./data
# SHFF_DB_PATH=./data/planner.db
# SHFF_STATIC_DIR=./web/dist
